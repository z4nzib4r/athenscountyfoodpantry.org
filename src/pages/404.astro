---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---

<Base title="Page not found">
  <PageHero eyebrow="404" title="We couldn't find that page" lead="It may have moved when we refreshed our website.">
    <div class="btn-row">
      <a class="btn" href="/">Go home</a>
      <a class="btn btn--outline" href="/get-food">Get food</a>
      <a class="btn btn--outline" href="/contact-us">Contact us</a>
    </div>
  </PageHero>
</Base>
