---
import { url } from '../utils/url';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Hours from '../components/Hours.astro';
import PostCard from '../components/PostCard.astro';
import { site } from '../data/site';

import heroImg from '../assets/photos/volunteers-pantry.jpg';
import foodBox from '../assets/photos/food-box.jpg';
import handingBox from '../assets/photos/handing-box.jpg';
import donorCheck from '../assets/photos/donor-check.jpg';

const posts = (await getCollection('posts'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <span class="eyebrow">Serving Southeast Ohio since 1980</span>
        <h1>Helping our neighbors with <em>food</em> and <em>support</em>.</h1>
        <p class="lead">
          The Athens County Food Pantry is an all-volunteer organization providing free groceries to
          families in Athens and surrounding counties. No judgment, just neighbors helping
          neighbors.
        </p>
        <div class="hero__ctas">
          <a class="hero-cta hero-cta--primary" href={url('/get-food')}>
            <span class="hero-cta__icon"><Icon name="basket" /></span>
            <span>
              <strong>Need food?</strong>
              <span>Hours, location &amp; how it works</span>
            </span>
            <Icon name="arrow" size={18} class="hero-cta__arrow" />
          </a>
          <a class="hero-cta" href={url('/support')}>
            <span class="hero-cta__icon"><Icon name="heart" /></span>
            <span>
              <strong>Want to help?</strong>
              <span>Donate or volunteer</span>
            </span>
            <Icon name="arrow" size={18} class="hero-cta__arrow" />
          </a>
        </div>
      </div>

      <div class="hero__media">
        <div class="photo hero__photo-main">
          <Image
            src={heroImg}
            alt="Pantry volunteers smiling among shelves stocked with boxed food"
            widths={[480, 720, 960, 1280]}
            sizes="(min-width: 900px) 36rem, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="photo hero__photo-small">
          <Image src={foodBox} alt="A box of groceries: pasta, rice, canned vegetables, and cereal" width={360} />
        </div>
        <div class="hero__badge">
          <strong>Open Mon–Fri</strong>
          <span>10am – 3pm</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick info strip -->
  <section class="info-strip" aria-label="Quick information">
    <div class="container info-strip__grid">
      <a class="info-item" href={site.mapsLink} target="_blank" rel="noopener">
        <Icon name="pin" />
        <span><strong>{site.address.line1}</strong>{site.address.city}, {site.address.state} {site.address.zip}</span>
      </a>
      <a class="info-item" href={site.phoneHref}>
        <Icon name="phone" />
        <span><strong>{site.phone}</strong>Call or text, any time</span>
      </a>
      <a class="info-item" href={url('/events')}>
        <Icon name="calendar" />
        <span><strong>First Saturdays</strong>1pm – 3pm, plus community events</span>
      </a>
    </div>
  </section>

  <!-- Story -->
  <section class="section section--white">
    <div class="container split">
      <div class="photo story__photo">
        <Image
          src={handingBox}
          alt="A volunteer handing a box of groceries to a client"
          widths={[480, 720, 1000]}
          sizes="(min-width: 900px) 34rem, 100vw"
        />
      </div>
      <div>
        <span class="eyebrow">Our story &amp; mission</span>
        <h2>Over 40 years of feeding families in Southeast Ohio</h2>
        <p class="lead">Our mission is “helping our neighbors with food and support.” True today, and true from our founding.</p>
        <p>
          Frank Hare, with other local pastors from Athens, started the Athens County Food Pantry in
          1980. His dedication and leadership helped the pantry grow from a collection of churches
          united to serve families into a vital organization that continues to fight food insecurity
          in the region.
        </p>
        <a class="btn btn--outline" href={url('/about')}>Learn more about us</a>
      </div>
    </div>
  </section>

  <!-- How we help -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">How we help</span>
        <h2>Simple, dignified access to food</h2>
      </div>
      <div class="grid">
        <article class="card feature">
          <span class="feature__icon"><Icon name="basket" /></span>
          <h3>A three-day supply</h3>
          <p>Shelf-stable staples plus fresh produce, bread, eggs and frozen protein when available, once every four weeks.</p>
        </article>
        <article class="card feature">
          <span class="feature__icon"><Icon name="truck" /></span>
          <h3>On the Road</h3>
          <p>We bring food to community locations like Albany, Trimble and New Marshfield for neighbors who can't make it to Millfield.</p>
        </article>
        <article class="card feature">
          <span class="feature__icon"><Icon name="users" /></span>
          <h3>100% volunteer-run</h3>
          <p>Every shift is staffed by neighbors who give their time, so your donations go straight to food.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="section section--green testimonial">
    <div class="container narrow">
      <span class="eyebrow">What our clients are saying</span>
      <div class="stars" aria-label="5 stars">
        {[1, 2, 3, 4, 5].map(() => <Icon name="star" size={20} />)}
      </div>
      <blockquote>
        <p>
          “Very friendly staff who actually went out of their way to help me out. They were on their
          way out the door to go home as I was walking in and welcomed me and insisted that I go
          ahead and come in even though I was technically a little late. We have a lot of really
          positive folks in our community and I've been blessed to have crossed some of their
          paths.”
        </p>
        <footer>Billie Joe</footer>
      </blockquote>
      <a class="btn btn--light" href={site.reviewsUrl} target="_blank" rel="noopener">
        Read more reviews <Icon name="external" size={16} />
      </a>
    </div>
  </section>

  <!-- Donors -->
  <section class="section section--white">
    <div class="container split split--reverse">
      <div class="photo">
        <Image
          src={donorCheck}
          alt="Representatives of Amesville Elementary presenting a $1,200 check from their Empty Bowls fundraiser"
          widths={[480, 720, 1000]}
          sizes="(min-width: 900px) 34rem, 100vw"
        />
      </div>
      <div>
        <span class="eyebrow">Thank you to our donors</span>
        <h2>We depend entirely on our community</h2>
        <p>
          Without donations both large and small, we could not do the work we do. We're thankful for
          our individual donors, including all our friends in Louisiana, Cincinnati, and beyond.
        </p>
        <p>
          We especially thank Joe Burrow for shining a light on hunger in SE Ohio, leading to the
          creation of our endowment, the <strong>Joe Burrow Hunger Relief Fund</strong>. (And Will
          Drabold and others for starting Facebook fundraisers.)
        </p>
        <div class="btn-row">
          <a class="btn" href={url('/support#donate')}><Icon name="heart" size={18} /> Make a donation</a>
          <a class="btn btn--outline" href={url('/donors')}>See our donors</a>
        </div>
      </div>
    </div>
  </section>

  <!-- News -->
  {
    posts.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="news-head">
            <div>
              <span class="eyebrow">From the pantry</span>
              <h2>Latest news</h2>
            </div>
            <a class="btn btn--outline" href={url('/news')}>All news</a>
          </div>
          <div class="grid">
            {posts.map((p) => <PostCard post={p} />)}
          </div>
        </div>
      </section>
    )
  }

  <!-- Visit -->
  <section class="section section--tint">
    <div class="container visit">
      <div class="card visit__card">
        <span class="eyebrow">Get in touch</span>
        <h2>Visit the pantry</h2>
        <p>
          {site.address.line1}, {site.address.city}, {site.address.state} {site.address.zip}<br />
          <span class="muted">{site.address.note}</span>
        </p>
        <Hours />
        <div class="btn-row">
          <a class="btn" href={site.phoneHref}><Icon name="phone" size={18} /> {site.phone}</a>
          <a class="btn btn--outline" href={url('/contact-us')}>Contact us</a>
        </div>
      </div>
      <div class="visit__map">
        <iframe
          src={site.mapEmbed}
          title="Map to the Athens County Food Pantry"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 7vw, 5.5rem);
    background:
      radial-gradient(70rem 36rem at 105% -20%, var(--green-100), transparent 60%),
      radial-gradient(50rem 26rem at -15% 120%, var(--harvest-soft), transparent 60%),
      var(--cream);
    overflow: hidden;
  }
  .hero__inner {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero__inner {
      grid-template-columns: 1.05fr 1fr;
    }
  }
  .hero h1 {
    font-size: clamp(2.5rem, 6.2vw, 4.4rem);
    line-height: 1.05;
  }
  .hero h1 em {
    font-style: italic;
    color: var(--green-600);
  }
  .hero__ctas {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
    max-width: 34rem;
  }
  @media (min-width: 600px) {
    .hero__ctas {
      grid-template-columns: 1fr 1fr;
    }
  }
  .hero-cta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1.1rem;
    border-radius: var(--radius);
    background: var(--paper);
    border: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  .hero-cta:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
    color: var(--ink);
    text-decoration: none;
  }
  .hero-cta > span:nth-child(2) {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    flex: 1;
  }
  .hero-cta strong {
    font-size: 1.1rem;
    color: var(--green-900);
  }
  .hero-cta > span:nth-child(2) > span {
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .hero-cta__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--green-100);
    color: var(--green-700);
  }
  .hero-cta--primary {
    background: var(--green-700);
    border-color: var(--green-700);
  }
  .hero-cta--primary strong,
  .hero-cta--primary > span:nth-child(2) > span,
  .hero-cta--primary:hover {
    color: #fff;
  }
  .hero-cta--primary .hero-cta__icon {
    background: rgb(255 255 255 / 0.15);
    color: #fff;
  }
  .hero-cta--primary :global(.hero-cta__arrow) {
    color: #fff;
  }
  :global(.hero-cta__arrow) {
    flex: none;
    color: var(--green-700);
    transition: transform 0.15s ease;
  }
  .hero-cta:hover :global(.hero-cta__arrow) {
    transform: translateX(3px);
  }

  .hero__media {
    position: relative;
    padding: 0 0 2.5rem 0;
  }
  @media (min-width: 600px) {
    .hero__media {
      padding: 0 0 3rem 3rem;
    }
  }
  .hero__photo-main {
    aspect-ratio: 4 / 3;
    border-radius: 2rem;
  }
  .hero__photo-small {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 38%;
    aspect-ratio: 1;
    border: 6px solid var(--cream);
    border-radius: 1.5rem;
    transform: rotate(-4deg);
  }
  .hero__badge {
    position: absolute;
    right: 1rem;
    bottom: 0.5rem;
    display: flex;
    flex-direction: column;
    padding: 0.85rem 1.2rem;
    border-radius: var(--radius);
    background: var(--harvest);
    color: var(--green-900);
    box-shadow: var(--shadow);
    line-height: 1.25;
    transform: rotate(2deg);
  }
  .hero__badge strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
  }

  /* Info strip */
  .info-strip {
    background: var(--green-800);
    color: #fff;
  }
  .info-strip__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }
  .info-item {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1.35rem 0.5rem;
    color: #fff;
    text-decoration: none;
    line-height: 1.35;
  }
  .info-item:hover {
    color: #fff;
  }
  .info-item:hover strong {
    text-decoration: underline;
  }
  .info-item :global(svg) {
    flex: none;
    color: var(--harvest);
  }
  .info-item span {
    display: flex;
    flex-direction: column;
    font-size: 0.92rem;
    color: rgb(255 255 255 / 0.75);
  }
  .info-item strong {
    font-size: 1.05rem;
    color: #fff;
  }
  @media (min-width: 860px) {
    .info-item + .info-item {
      border-left: 1px solid rgb(255 255 255 / 0.15);
      padding-left: 1.75rem;
    }
  }

  .story__photo {
    aspect-ratio: 5 / 4;
  }

  .feature__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.9rem;
    background: var(--green-100);
    color: var(--green-700);
    margin-bottom: 1rem;
  }

  /* Testimonial */
  .testimonial {
    text-align: center;
  }
  .stars {
    display: flex;
    justify-content: center;
    gap: 0.2rem;
    color: var(--harvest);
    margin-bottom: 1rem;
  }
  .stars :global(svg) {
    fill: currentColor;
  }
  .testimonial blockquote {
    margin: 0 0 2rem;
  }
  .testimonial blockquote p {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.6vw, 1.7rem);
    line-height: 1.45;
    color: #fff;
  }
  .testimonial blockquote footer {
    font-weight: 700;
    color: var(--harvest);
  }

  .news-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .news-head h2 {
    margin: 0;
  }

  /* Visit */
  .visit {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 900px) {
    .visit {
      grid-template-columns: 1fr 1.1fr;
    }
  }
  .visit__card {
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
  .muted {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .visit__map {
    min-height: 22rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
    background: var(--green-100);
  }
  .visit__map iframe {
    width: 100%;
    height: 100%;
    min-height: 22rem;
    border: 0;
  }
</style>
