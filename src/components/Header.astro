---
import { stripBase, url } from '../utils/url';
import { Image } from 'astro:assets';
import logo from '../assets/logo.svg';
import { nav, site } from '../data/site';

const path = stripBase(Astro.url.pathname).replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  path === href || (href === '/news' && path.startsWith('/post/'));
---

{
  site.announcement.text && (
    <a class="announce" href={url(site.announcement.href)}>
      <span class="announce__dot" aria-hidden="true" />
      <span>{site.announcement.text}</span>
      <span class="announce__arrow" aria-hidden="true">→</span>
    </a>
  )
}

<header class="header" data-header>
  <div class="container header__inner">
    <a href={url('/')} class="brand" aria-label={`${site.name} – home`}>
      <Image src={logo} alt="" width={72} height={57} loading="eager" />
      <span class="brand__text">
        <span class="brand__top">Athens County</span>
        <span class="brand__bottom">Food Pantry</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul class="nav__list" id="nav-list">
        {
          nav.map((item) => (
            <li>
              <a
                href={url(item.href)}
                class="nav__link"
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="nav__mobile-cta">
          <a class="btn" href={url('/get-food')}>Get Food</a>
          <a class="btn btn--harvest" href={url('/support#donate')}>Donate</a>
        </li>
      </ul>
    </nav>

    <div class="header__actions">
      <a class="btn btn--harvest header__donate" href={url('/support#donate')}>Donate</a>
      <button
        class="menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="nav-list"
        data-menu-btn
      >
        <span class="sr-only">Menu</span>
        <span class="menu-btn__bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (btn && header) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      header.classList.toggle('is-open', open);
      document.body.classList.toggle('nav-open', open);
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
    window.matchMedia('(min-width: 1024px)').addEventListener('change', () => setOpen(false));
  }
</script>

<style>
  .announce {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.6rem var(--gutter);
    background: var(--green-900);
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
  }
  .announce:hover {
    color: #fff;
    background: #102a0f;
  }
  .announce__dot {
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--harvest);
    box-shadow: 0 0 0 4px rgb(242 181 68 / 0.25);
  }
  .announce__arrow {
    transition: transform 0.15s ease;
  }
  .announce:hover .announce__arrow {
    transform: translateX(3px);
  }

  .header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 50;
    background: rgb(251 248 242 / 0.92);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.75rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    margin-right: auto;
  }
  .brand img {
    width: 3.25rem;
    height: auto;
  }
  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1;
    font-family: var(--font-display);
  }
  .brand__top {
    font-size: 0.85rem;
    color: var(--green-700);
    font-weight: 500;
  }
  .brand__bottom {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--brown-600);
  }

  .nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .nav__link {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 999px;
    color: var(--ink);
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: none;
  }
  .nav__link:hover {
    background: var(--green-50);
    color: var(--green-800);
  }
  .nav__link[aria-current='page'] {
    background: var(--green-100);
    color: var(--green-800);
  }
  .nav__mobile-cta {
    display: none;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .header__donate {
    min-height: 2.6rem;
    padding: 0.5rem 1.2rem;
  }

  .menu-btn {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--paper);
    cursor: pointer;
    position: relative;
  }
  .menu-btn__bars,
  .menu-btn__bars::before,
  .menu-btn__bars::after {
    position: absolute;
    left: 50%;
    width: 1.1rem;
    height: 2px;
    background: var(--green-900);
    border-radius: 2px;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }
  .menu-btn__bars {
    top: 50%;
    transform: translate(-50%, -50%);
  }
  .menu-btn__bars::before,
  .menu-btn__bars::after {
    content: '';
    transform: translateX(-50%);
  }
  .menu-btn__bars::before {
    top: -6px;
  }
  .menu-btn__bars::after {
    top: 6px;
  }
  .is-open .menu-btn__bars {
    background: transparent;
  }
  .is-open .menu-btn__bars::before {
    transform: translate(-50%, 6px) rotate(45deg);
  }
  .is-open .menu-btn__bars::after {
    transform: translate(-50%, -6px) rotate(-45deg);
  }

  @media (max-width: 1023.98px) {
    .menu-btn {
      display: block;
    }
    .nav {
      position: fixed;
      inset: 4.75rem 0 0 0;
      background: var(--cream);
      padding: 1rem var(--gutter) calc(2rem + env(safe-area-inset-bottom, 0px));
      overflow-y: auto;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition:
        opacity 0.2s ease,
        transform 0.2s ease,
        visibility 0.2s;
    }
    .is-open .nav {
      visibility: visible;
      opacity: 1;
      transform: none;
    }
    .nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
    }
    .nav__link {
      font-family: var(--font-display);
      font-size: 1.5rem;
      padding: 0.75rem 1rem;
      border-radius: var(--radius);
    }
    .nav__mobile-cta {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
      margin-top: 1.25rem;
    }
  }

  @media (max-width: 420px) {
    .header__donate {
      display: none;
    }
    .brand__bottom {
      font-size: 1.15rem;
    }
  }

  :global(body.nav-open) {
    overflow: hidden;
  }
</style>
