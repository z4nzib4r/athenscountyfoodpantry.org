---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { url } from '../utils/url';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { title, date, excerpt, cover, coverAlt, category } = post.data;
const href = url(`/post/${post.id}`);
---

<article class="post-card">
  <a href={href} class="post-card__media" tabindex="-1" aria-hidden="true">
    <Image src={cover} alt={coverAlt} widths={[400, 640]} sizes="(min-width: 900px) 22rem, 100vw" />
  </a>
  <div class="post-card__body">
    <p class="post-card__meta">
      <span>{category}</span>
      <time datetime={date.toISOString()}>
        {date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}
      </time>
    </p>
    <h3><a href={href}>{title}</a></h3>
    <p>{excerpt}</p>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .post-card__media {
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--green-50);
    overflow: hidden;
  }
  .post-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .post-card__body {
    padding: 1.25rem 1.4rem 1.5rem;
  }
  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    font-size: 0.82rem;
    color: var(--ink-soft);
    margin-bottom: 0.5rem;
  }
  .post-card__meta span {
    font-weight: 700;
    color: var(--brown-600);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .post-card h3 {
    margin-bottom: 0.5rem;
  }
  .post-card h3 a {
    color: var(--green-900);
    text-decoration: none;
  }
  /* Whole card is clickable via the title link */
  .post-card h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .post-card__body p:last-child {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.97rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
